<Window x:Class="ProxyTunnelPrototype.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Proxy Tunnel · Прототип" Width="1080" Height="850" MinWidth="940" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#FAFBF9" FontFamily="Segoe UI" FontSize="14" Foreground="#18241E">
 <Window.Resources>
  <SolidColorBrush x:Key="Green" Color="#176A48"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#25392D"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#DAE3DC"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#176A48"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#176A48"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,9"/><Setter Property="Background" Value="#FCFDFC"/><Setter Property="BorderBrush" Value="#D9E2DC"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="CheckBorder" Width="20" Height="20" Background="White" BorderBrush="#B7C5B7" BorderThickness="1" CornerRadius="5" Margin="0,0,9,0"><TextBlock x:Name="Tick" Text="✓" FontSize="15" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#27834E"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#27834E"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E7E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#758178"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 </Window.Resources>
 <Grid Background="#FAFBF9">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#E5EAE5" BorderThickness="0,0,0,1" Padding="23,0">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E9F4E9" CornerRadius="10" Width="34" Height="34"><TextBlock Text="∩" Foreground="#187444" FontSize="36" FontWeight="Bold" Margin="4,-14,0,0"/></Border><TextBlock Text="Proxy Tunnel" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/><TextBlock Text="ПРОТОТИП 0.1.11" Foreground="#8B968C" FontSize="10" VerticalAlignment="Center" Margin="9,2,0,0"/></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#F6F8F4" BorderBrush="#E3E9E2" BorderThickness="0,0,1,0" Padding="14,22,14,16">
    <DockPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Tag="settings" Click="Navigate"><TextBlock Text="⚙   Настройки"/></Button><TextBlock Text="Ваш сервер. Ваш маршрут." FontSize="10" Foreground="#8A958B" Margin="15,16,0,0"/></StackPanel><StackPanel>
     <Button x:Name="OverviewNav" Style="{StaticResource Nav}" Tag="overview" Click="Navigate" Content="⌂   Обзор"/>
     <Button x:Name="ServicesNav" Style="{StaticResource Nav}" Tag="services" Click="Navigate" Content="▱   Сервисы"/>
     <Button x:Name="ServerNav" Style="{StaticResource Nav}" Tag="server" Click="Navigate" Content="▤   Сервер"/>
     <Button x:Name="LogNav" Style="{StaticResource Nav}" Tag="log" Click="Navigate"><Grid Width="116" ClipToBounds="False"><TextBlock Text="☷   Журнал"/><Grid x:Name="IssueIndicator" Visibility="Collapsed" Width="22" Height="22" HorizontalAlignment="Right" ClipToBounds="False"><Border Background="#B93636" CornerRadius="11"><TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="IssueCountBubble" Background="#FBE8E8" BorderBrush="#B93636" BorderThickness="1" CornerRadius="8" MinWidth="17" Height="17" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-9,0"><TextBlock x:Name="IssueCount" Text="2" FontSize="10" Foreground="#9A2626" HorizontalAlignment="Center"/></Border></Grid></Grid></Button>
    </StackPanel></DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="32,26,32,0">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="29" FontWeight="SemiBold"/><Border Background="#EFF3ED" CornerRadius="20" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="TopStatus" Text="●  Выключен" FontSize="12" Foreground="#617365"/></Border></Grid>
    <Border x:Name="NoticeBox" Grid.Row="1" Background="#FFF1DE" CornerRadius="9" Padding="13,10" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#815524"/></Border>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,8,12">
     <Grid>
      <StackPanel x:Name="OverviewPage">
       <Border Style="{StaticResource Card}" Background="#EEF7ED" BorderBrush="#D6E8D4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ConnectionTitle" Text="Туннель выключен" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ServerSummary" Style="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel><Button x:Name="ConnectButton" Grid.Column="1" Style="{StaticResource Primary}" Content="Подключиться" VerticalAlignment="Center" Click="ToggleConnection"/></Grid></Border>
       <Border x:Name="ModeCard" Style="{StaticResource Card}" Padding="32,27"><StackPanel HorizontalAlignment="Center" MaxWidth="570">
        <Border Background="#F1F7EE" CornerRadius="40" Width="80" Height="80" Margin="0,0,0,20"><Grid Width="51" Height="51"><Ellipse Stroke="#36804E" StrokeThickness="2.3"/><Ellipse Stroke="#36804E" StrokeThickness="2" Width="25"/><Path Stroke="#36804E" StrokeThickness="2" Data="M 3,15 Q 25.5,24 48,15 M 1,26 L 50,26 M 3,37 Q 25.5,29 48,37"/></Grid></Border>
        <TextBlock x:Name="ModeHeading" Text="Весь интернет — через ваш VPS" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock x:Name="ModeDescription" Style="{StaticResource Muted}" Margin="0,13,0,8" TextAlignment="Center"/>
        <Button Content="Изменить в настройках →" Tag="settings" Click="Navigate" Background="Transparent" BorderThickness="0" Foreground="#176A48" Padding="8"/>
       </StackPanel></Border>
       <Border x:Name="OverviewServicesCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Через туннель" Style="{StaticResource Heading}"/><TextBlock Text="Выбранные сервисы используют VPS. Остальной интернет идёт напрямую." Style="{StaticResource Muted}" Margin="0,0,0,18"/><WrapPanel x:Name="OverviewServiceRows"/><Button Content="Изменить в настройках →" Tag="services" Click="Navigate" Background="Transparent" BorderThickness="0" Foreground="#176A48" HorizontalAlignment="Left" Padding="0,10,0,0"/></StackPanel></Border><Border Background="#F1F6ED" CornerRadius="9" Padding="13,10" Margin="0,0,0,14"><Grid><StackPanel><TextBlock x:Name="ProtectionText" Text="Kill switch выключен" FontSize="12"/><TextBlock x:Name="LossText" Text="Потери связи в сеансе: 0" FontSize="11" Foreground="#758178" Margin="0,3,0,0"/></StackPanel><Button x:Name="ReleaseProtectionButton" Content="Отключить защиту" HorizontalAlignment="Right" Visibility="Collapsed" Padding="11,7" Click="ReleaseProtection"/></Grid></Border><UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,10,18" Padding="18"><StackPanel><TextBlock Text="ВЫХОДНОЙ IP" FontSize="10" Foreground="#78867A"/><TextBlock x:Name="ExitIp" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,18" Padding="18"><StackPanel><TextBlock Text="PING ДО VPS (TCP)" FontSize="10" Foreground="#78867A"/><TextBlock x:Name="Latency" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="PingUpdated" Text="ещё не измерен" FontSize="10" Foreground="#78867A" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="ВРЕМЯ ПОДКЛЮЧЕНИЯ" FontSize="10" Foreground="#78867A"/><TextBlock x:Name="Uptime" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
       <Grid><TextBlock x:Name="CheckSummary" Style="{StaticResource Muted}" Text="Подключение ещё не проверено." VerticalAlignment="Center"/><Button Content="Проверить соединение" HorizontalAlignment="Right" Click="CheckConnection"/></Grid>
      </StackPanel>
      <StackPanel x:Name="ServicesPage" Visibility="Collapsed">
       <TextBlock Text="Выберите, какие сайты и приложения используют VPS." Style="{StaticResource Muted}" Margin="0,0,0,15"/>
       <Border x:Name="AllModeNotice" Background="#EAF4E6" CornerRadius="9" Padding="15" Margin="0,0,0,16"><TextBlock Text="Сейчас через туннель идёт весь интернет. Снимите галочку в настройках, чтобы выбирать сервисы." TextWrapping="Wrap"/></Border>
       <Border Style="{StaticResource Card}" Padding="22,8"><StackPanel x:Name="ServiceRows"/></Border>
       <TextBlock Text="Свои правила" Style="{StaticResource Heading}"/>
       <StackPanel x:Name="CustomRules"><TextBlock Text="Домены · один в строке, без https://" Style="{StaticResource Muted}"/><TextBox x:Name="DomainsBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,6,0,13"/><TextBlock Text="Приложения · имена процессов, например Telegram.exe" Style="{StaticResource Muted}"/><TextBox x:Name="ProcessesBox" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" Margin="0,6,0,16"/></StackPanel>
       <Button Style="{StaticResource Primary}" Content="Сохранить правила" HorizontalAlignment="Right" Click="SaveRules"/>
       <TextBlock Text="Выбор приложения направляет все его соединения через VPS. Для веб-правил используются домены и определение адресов соединений. Узлы расширений и CLI на Node.js можно добавить как node.exe (это охватит все такие процессы)." Style="{StaticResource Muted}" FontSize="12" Margin="0,15,0,0"/>
      </StackPanel>
      <StackPanel x:Name="ServerPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Журнал VPS" Style="{StaticResource Heading}"/><TextBlock Text="Получить сохранённые записи службы за выбранный период. Используются сохранённые параметры сервера и SSH-ключ; для разового входа можно ввести пароль ниже." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/><WrapPanel><Button x:Name="FetchVpsLogsButton" Content="Получить логи VPS" Style="{StaticResource Primary}" Click="FetchVpsLogs" Margin="0,0,8,8"/><Button x:Name="VpsPeriodButton" Content="1h ▾" MinWidth="58" Click="OpenVpsPeriod" Margin="0,0,8,8" ToolTip="Период серверного журнала"><Button.ContextMenu><ContextMenu><MenuItem Header="За последний час (1h)" Tag="Hour" IsCheckable="True" IsChecked="True" Click="SelectVpsPeriod"/><MenuItem Header="За 5 часов (5h)" Tag="FiveHours" IsCheckable="True" Click="SelectVpsPeriod"/><MenuItem Header="За день (1d)" Tag="Day" IsCheckable="True" Click="SelectVpsPeriod"/><MenuItem Header="За неделю (7d)" Tag="Week" IsCheckable="True" Click="SelectVpsPeriod"/><MenuItem Header="За месяц (1m)" Tag="Month" IsCheckable="True" Click="SelectVpsPeriod"/><MenuItem Header="За всё время (∞)" Tag="All" IsCheckable="True" Click="SelectVpsPeriod"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="SaveVpsLogsButton" Content="Сохранить…" Click="SaveVpsLogs" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="VpsLogsStatus" Text="Серверные записи ещё не получены." Style="{StaticResource Muted}" FontSize="12"/><TextBox x:Name="VpsLogsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="200" Margin="0,12,0,0" Visibility="Collapsed" FontFamily="Consolas" FontSize="11"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ваш VPS" Style="{StaticResource Heading}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,14"><TextBlock Text="IPv4-адрес сервера" Style="{StaticResource Muted}"/><TextBox x:Name="HostBox" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SSH-порт" Style="{StaticResource Muted}"/><TextBox x:Name="SshPortBox" Margin="0,6,0,0"/></StackPanel></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,14"><TextBlock Text="Администратор SSH" Style="{StaticResource Muted}"/><TextBox x:Name="UserBox" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Порт канала" Style="{StaticResource Muted}"/><TextBox x:Name="TunnelPortBox" Margin="0,6,0,0"/></StackPanel></Grid>
        <TextBlock Text="Локация VPS (по данным хостинга)" Style="{StaticResource Muted}"/><TextBox x:Name="LocationBox" Margin="0,6,0,14"/><TextBlock Text="SSH-ключ администратора" Style="{StaticResource Muted}"/><DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="Выбрать…" Click="ChooseKey" Margin="10,0,0,0"/><TextBox x:Name="KeyBox"/></DockPanel>
        <TextBlock Text="Или пароль SSH · для разового действия" Style="{StaticResource Muted}"/><PasswordBox x:Name="Password" Padding="11,10" BorderBrush="#D9E2DC" Margin="0,6,0,10"/>
        <TextBlock Text="Пароль SSH не сохраняется. После подготовки обычное подключение работает без root-доступа." Style="{StaticResource Muted}" FontSize="12"/>
        <WrapPanel Margin="0,20,0,0"><Button Content="Подготовить VPS" Style="{StaticResource Primary}" Click="PrepareServer" Margin="0,0,10,8"/><Button Content="Проверить SSH" Click="ProbeServer" Margin="0,0,10,8"/><Button Content="Сохранить" Click="SaveServer" Margin="0,0,0,8"/></WrapPanel>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}" Background="#F3F7F0"><StackPanel><TextBlock x:Name="ProvisionStatus" FontWeight="SemiBold"/><TextBlock Text="Подготовка добавит отдельную зашифрованную службу и откроет выбранный порт TCP/UDP. Требуется Ubuntu/Debian x86_64, systemd и root. Если у хостинга есть внешний межсетевой экран, разрешите этот же порт в его панели." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="LogPage" Visibility="Collapsed"><Grid Margin="0,0,0,15"><TextBlock Text="События соединения" Style="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CopyLogsButton" Content="Копировать логи" Padding="12,7" Margin="0,0,6,0" Click="CopyLogs"/><Button x:Name="CopyPeriodButton" Content="∞ ▾" Padding="10,7" MinWidth="58" Margin="0,0,8,0" Click="OpenCopyPeriod" ToolTip="Период копирования: за всё время" AutomationProperties.Name="Выбрать период копирования логов"><Button.ContextMenu><ContextMenu><MenuItem Header="За последний час (1h)" Tag="Hour" IsCheckable="True" Click="SelectCopyPeriod"/><MenuItem Header="За 5 часов (5h)" Tag="FiveHours" IsCheckable="True" Click="SelectCopyPeriod"/><MenuItem Header="За день (1d)" Tag="Day" IsCheckable="True" Click="SelectCopyPeriod"/><MenuItem Header="За неделю (7d)" Tag="Week" IsCheckable="True" Click="SelectCopyPeriod"/><MenuItem Header="За месяц (1m)" Tag="Month" IsCheckable="True" Click="SelectCopyPeriod"/><MenuItem Header="За всё время (∞)" Tag="All" IsCheckable="True" IsChecked="True" Click="SelectCopyPeriod"/></ContextMenu></Button.ContextMenu></Button><Button Content="Сохранить…" Padding="12,7" Click="ExportLog"/></StackPanel></Grid><Border x:Name="IncidentPanel" Background="#EDF5E8" CornerRadius="8" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="IncidentStatus" Text="Зафиксированных сбоев пока нет." VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0"/><Button x:Name="SaveIncidentButton" Grid.Column="1" Content="Сохранить отчёт о сбое" Padding="10,7" Click="SaveIncident" IsEnabled="False"/></Grid></Border><ListBox x:Name="LogList" Height="470" Background="#F4F7F2" BorderBrush="#DDE6DC" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" Padding="8"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="На экране последние 24 часа; история хранится один месяц. Красные строки требуют проверки. Уведомление сбрасывается при входе, строки сохраняются. Повторы сгруппированы, чувствительные поля скрыты." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel>
      <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Обновления" Style="{StaticResource Heading}"/><TextBlock Text="Проверка GitHub Releases и загрузка идут через VPS. Перед установкой проверяется подпись; на время замены файлов интернет блокируется. Нужны полный режим и kill switch." Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="UpdateButton" Content="Проверить обновления" Click="CheckUpdate" Padding="14,9"/><Button x:Name="CancelUpdateButton" Content="Отменить загрузку" Click="CancelUpdate" Visibility="Collapsed" Margin="8,0,0,0"/><Button x:Name="RollbackUpdateButton" Content="Вернуть прежнюю версию" Click="RollbackUpdate" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="UpdateStatus" Text="Источник: lonchdev/proxy-tunnel-desktop · GitHub Releases" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Маршрутизация" Style="{StaticResource Heading}"/><CheckBox x:Name="AllTrafficBox" Content="Весь трафик через туннель" FontWeight="SemiBold" FontSize="17" Checked="ModeChanged" Unchecked="ModeChanged"/><TextBlock Text="Внешние TCP/UDP-соединения браузеров и приложений идут через VPS. Локальная сеть и само соединение с сервером идут напрямую. ICMP (ping) не поддерживается туннелем." Style="{StaticResource Muted}" Margin="20,3,0,12"/><Border Background="#EDF5E8" CornerRadius="8" Padding="14"><StackPanel><TextBlock x:Name="ModeNote" TextWrapping="Wrap"/><Button Content="Выбрать сайты и приложения →" Tag="services" Click="Navigate" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left" Foreground="#176A48" Padding="0,9,0,0"/></StackPanel></Border></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Поведение приложения" Style="{StaticResource Heading}"/><CheckBox x:Name="AutostartBox" Content="Автозагрузка — запускать при входе в Windows"/><TextBlock Text="Запускается после включения или перезагрузки и входа в вашу учётную запись. Сохранённый сервер подключается автоматически. Переместили EXE — сохраните эту настройку заново." Style="{StaticResource Muted}" FontSize="12" Margin="20,0,0,10"/><CheckBox x:Name="KillSwitchBox" Content="Блокировать прямой интернет при обрыве (kill switch)"/><TextBlock Text="Включается вместе с туннелем. При обрыве и сбое приложения блокировка сохраняется до ручного отключения. Локальная сеть остаётся доступной. Защита WSL и виртуальных машин отдельно не подтверждена." Style="{StaticResource Muted}" FontSize="12" Margin="20,0,0,10"/><CheckBox x:Name="ReconnectBox" Content="Переподключаться автоматически"/><TextBlock Text="При потере связи приложение повторяет подключение. При включённом kill switch прямой интернет остаётся заблокированным до восстановления канала или нажатия «Отключить»." Style="{StaticResource Muted}" FontSize="12" Margin="20,0,0,10"/><TextBlock Text="При автозагрузке сохранённый сервер подключается автоматически. На время подключения браузеры используют прокси приложения. При отключении прежние настройки восстанавливаются." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
       <Grid><TextBlock Text="Изменения применятся после сохранения." Style="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Сохранить настройки" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="SaveOptions"/></Grid>
      </StackPanel>
     </Grid>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E4EAE3" BorderThickness="0,1,0,0" Padding="23,0"><Grid><TextBlock x:Name="FooterStatus" Text="Готов к настройке" FontSize="11" Foreground="#768379" VerticalAlignment="Center"/><TextBlock Text="Windows x64  ·  личный VPS" FontSize="11" Foreground="#8A968B" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>








